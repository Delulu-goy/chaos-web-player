# Chaos Radio backend — environment variables template
# Copia questo in .env e sostituisci i valori placeholder.

# Database MySQL (formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL="mysql://chaos_app:your_password@localhost:3306/chaos_radio"

# JWT secret — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_random_64_bytes_hex_string"

# Porta backend
PORT=3001

# Ambiente: "development" | "production"
NODE_ENV="development"

# ── Libreria audio ───────────────────────────────────────────────────────
# Cartella dei brani (la "libreria fisica"). Lo scanner ci gira ogni 5 min.
# MUSIC_DIR="private/audio"

# ── Pirate Day ───────────────────────────────────────────────────────────
# Cartella dei MP3 del Pirate Day. DEVE stare dentro MUSIC_DIR: fuori, lo
# scanner la tratterebbe come track orfani e cancellerebbe i brani ogni
# 5 minuti (e le waveform non verrebbero calcolate).
# PIRATE_DAY_DIR="private/audio/pirate-day"

# Manifest dell'edizione (JSON), relativo a PIRATE_DAY_DIR.
# PIRATE_DAY_MANIFEST="manifest.json"

# Durata della finestra "in onda" del Pirate Day, in ore.
# PIRATE_DAY_WINDOW_HOURS=24

# Se "1", la fase cleanup del Pirate Day cancella solo le righe del DB e
# lascia i file su disco (debug).
# PIRATE_DAY_KEEP_FILES=0

# ── Generatore del manifest (pirate-day:init) ───────────────────────────
# Data di pubblicazione dell'edizione successiva. Se non impostata, viene
# calcolata come "prossimo venerdì 22:00" (Europe/Rome).
# PIRATE_DAY_INIT_PUBLISH_AT=

# Giorno e ora della pubblicazione (usati solo se PIRATE_DAY_INIT_PUBLISH_AT
# non è impostata).
# PIRATE_DAY_INIT_WEEKDAY=Fri
# PIRATE_DAY_INIT_HOUR=22
# PIRATE_DAY_INIT_TZ=Europe/Rome

# Descrizione delle edizioni: è la STESSA per tutte, quindi sta qui.
# I "\n" diventano a capo veri nel manifest.
# PIRATE_DAY_DESCRIPTION="**A new transmission begins.**\n\nCurated by…"

# Curatore di RISERVA: vale solo se il manifest non ne ha uno (prima
# edizione). Dalla seconda in poi il curatore vive nel manifest, perché
# cambia a ogni edizione.
# PIRATE_DAY_CURATOR_NAME="DJ Skeleton"
# PIRATE_DAY_CURATOR_ROLE="Resident Curator"
# PIRATE_DAY_CURATOR_AVATAR=""
# PIRATE_DAY_CURATOR_LINKS={"spotify":"https://…","soundcloud":"https://…"}